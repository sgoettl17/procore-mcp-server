# Procore OAuth credentials (from Procore Developer Portal)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# Default company ID (integer) — used as Procore-Company-Id header
PROCORE_COMPANY_ID=

# Optional: custom token storage path (default: ~/.procore-mcp/tokens.json)
# PROCORE_TOKEN_PATH=

# Streamable HTTP sidecar (Paperclip / Docker)
# PROCORE_MCP_PORT=9220
# PROCORE_MCP_BIND=0.0.0.0
# PROCORE_MCP_PATH=/mcp
# PROCORE_MCP_TOKEN=          # optional bearer auth for POST /mcp
